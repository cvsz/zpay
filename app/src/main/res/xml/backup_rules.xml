<?xml version="1.0" encoding="utf-8"?>
<!--
  ZWallet backup rules.
  The Room database (apex_wallet_database) contains encrypted key material and financial
  transaction state and MUST NOT be included in cloud/ADB backups. Backups are also disabled
  via android:allowBackup="false" in the manifest.
-->
<full-backup-content>
    <exclude domain="database" path="apex_wallet_database" />
    <exclude domain="sharedpref" path="device.xml" />
</full-backup-content>
